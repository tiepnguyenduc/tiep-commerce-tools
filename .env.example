# Server-only commercetools credentials. Never prefix these with NEXT_PUBLIC_.
CTP_PROJECT_KEY=
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com
CTP_API_URL=https://api.europe-west1.gcp.commercetools.com
CTP_SCOPES=manage_project:your-project manage_sessions:your-project
CTP_CHECKOUT_APP_KEY=

# Dedicated server-only B2B project. Fill all six fields together.
# Leave all six empty only when intentionally sharing the B2C project.
CTP_B2B_PROJECT_KEY=
CTP_B2B_CLIENT_ID=
CTP_B2B_CLIENT_SECRET=
CTP_B2B_AUTH_URL=
CTP_B2B_API_URL=
CTP_B2B_SCOPES=

# Legacy checkout context (uses the main CTP_* project, not /b2b).
# Associate ID is normally the Customer ID of the signed-in associate.
CTP_B2B_ASSOCIATE_ID=
CTP_B2B_BUSINESS_UNIT_KEY=
CTP_B2B_STORE_KEY=
CTP_B2B_DISTRIBUTION_CHANNEL_KEY=
CTP_B2B_SUPPLY_CHANNEL_KEY=

# B2B portal (/b2b): authenticated cookie session and merchant-controlled onboarding.
# Generate a separate random secret (32+ characters); required in production.
B2B_SESSION_SECRET=
CTP_B2B_ADMIN_ROLE_KEY=b2b-admin
CTP_B2B_BUYER_ROLE_KEY=b2b-buyer
CTP_B2B_CURRENCY=USD
CTP_B2B_COUNTRY=US
# Optional: grant ONLY these Stores to new companies. Empty requires merchant assignment.
# Review before enabling: b2b-standard,b2b-preferred
CTP_B2B_ONBOARDING_STORE_KEYS=

# Where photos and videos attached to reviews are stored. Defaults to .data/review-media.
REVIEW_MEDIA_DIR=

# Optional training switches
CTP_LOCALE=en-US
CTP_CURRENCY=USD
CTP_COUNTRY=US
