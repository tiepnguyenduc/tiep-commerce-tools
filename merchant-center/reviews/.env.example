# Copy to `.env.local`. `mc-scripts` loads it and `custom-application-config.mjs`
# reads these values through `${env:...}`.

# Region of the commercetools project, e.g. gcp-eu, gcp-us, aws-eu, aws-us.
CLOUD_IDENTIFIER=gcp-eu
# Project opened after logging in during local development (`npm start`).
CTP_INITIAL_PROJECT_KEY=
# Only used by production builds; any value works for `npm start`.
# Application ID shown in Merchant Center after "Add a Custom Application".
CUSTOM_APPLICATION_ID=
# Public HTTPS URL where the built `public/` folder is hosted.
APPLICATION_URL=
